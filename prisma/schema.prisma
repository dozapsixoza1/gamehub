generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ======================
// ПОЛЬЗОВАТЕЛИ
// ======================

model User {
  id            String   @id @default(cuid())
  telegramId    BigInt   @unique
  username      String?
  firstName     String?
  lastName      String?
  languageCode  String?  @default("ru")
  photoUrl      String?
  
  // Валюта
  coins         Int      @default(100)   // основная валюта
  gems          Int      @default(0)     // премиум валюта
  
  // Статистика
  gamesPlayed   Int      @default(0)
  gamesWon      Int      @default(0)
  xp            Int      @default(0)
  level         Int      @default(1)
  referralCode  String   @unique @default(cuid())
  referredById  String?
  dailyStreak   Int      @default(0)
  roleStats     Json     @default("{}")
  lastDailyAt   DateTime?
  
  isAdmin       Boolean  @default(false)
  isVerified    Boolean  @default(false)
  isBanned      Boolean  @default(false)
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  lastActiveAt  DateTime @default(now())
  settings      UserSettings?
  adminStaff    AdminStaff?
  xpTransactions XpTransaction[]
  sentDirectMessages DirectMessage[] @relation("DirectMessageSender")
  receivedDirectMessages DirectMessage[] @relation("DirectMessageRecipient")
  blocksMade UserBlock[] @relation("BlockOwner")
  blocksReceived UserBlock[] @relation("BlockTarget")
  messageReports MessageReport[]
  nftOrders NftOrder[]
  nftOwnerships UserNft[]
  roomMessages  RoomMessage[]
  roomReactions RoomReaction[]
  reportsMade   PlayerReport[] @relation("ReportAuthor")
  reportsReceived PlayerReport[] @relation("ReportTarget")

  // Relations
  promoRedemptions PromoRedemption[]
  purchases        Purchase[]
  starOrders       StarOrder[]
  mafiaPlayers     MafiaPlayer[]
  bunkerPlayers    BunkerPlayer[]
  ownedItems       UserItem[]
  achievements     UserAchievement[]
  dailyRewards     DailyReward[]
  matchHistory     MatchHistory[]
  friendshipsSent Friendship[] @relation("FriendshipRequester")
  friendshipsReceived Friendship[] @relation("FriendshipAddressee")
  challengesSent PlayerChallenge[] @relation("ChallengeSender")
  challengesReceived PlayerChallenge[] @relation("ChallengeRecipient")
  clanMemberships ClanMember[]
  clanApplications ClanApplication[]
  ownedClans Clan[] @relation("ClanOwner")
  notifications AppNotification[]
  questClaims QuestClaim[]
  seasonRewards SeasonReward[]
  battlePassClaims BattlePassClaim[]
  battlePassUnlocks BattlePassUnlock[]
  referralsMade    User[] @relation("UserReferrals")
  referredBy       User? @relation("UserReferrals", fields: [referredById], references: [id], onDelete: SetNull)

  @@index([telegramId])
  @@map("users")
}

// ======================
// ПРОМОКОДЫ
// ======================

model PromoCode {
  id          String   @id @default(cuid())
  code        String   @unique
  coins       Int      @default(0)
  gems        Int      @default(0)
  maxUses     Int?     // null = бесконечно
  usedCount   Int      @default(0)
  expiresAt   DateTime?
  isActive    Boolean  @default(true)
  createdBy   BigInt   // telegramId админа
  createdAt   DateTime @default(now())

  redemptions PromoRedemption[]

  @@map("promo_codes")
}

model PromoRedemption {
  id        String   @id @default(cuid())
  userId    String
  promoId   String
  redeemedAt DateTime @default(now())

  user  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  promo PromoCode @relation(fields: [promoId], references: [id], onDelete: Cascade)

  @@unique([userId, promoId])
  @@map("promo_redemptions")
}

// ======================
// МАГАЗИН
// ======================

model ShopItem {
  id          String   @id @default(cuid())
  name        String
  description String?
  gameId      String   // "mafia" | "bunker" | "global" и т.д.
  category    String   // "roles" | "skins" | "boosts" | "currency"
  priceCoins  Int      @default(0)
  priceGems   Int      @default(0)
  imageUrl    String?
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  metadata    Json?    // дополнительные данные (например, какая роль)

  purchases Purchase[]
  ownedBy   UserItem[]

  @@index([gameId, category])
  @@map("shop_items")
}

model Purchase {
  id        String   @id @default(cuid())
  userId    String
  itemId    String
  pricePaid Int
  currency  String   // "coins" | "gems"
  createdAt DateTime @default(now())

  user User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  item ShopItem @relation(fields: [itemId], references: [id])

  @@map("purchases")
}

model UserItem {
  id        String   @id @default(cuid())
  userId    String
  itemId    String
  quantity  Int      @default(1)
  acquiredAt DateTime @default(now())

  user User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  item ShopItem @relation(fields: [itemId], references: [id])

  @@unique([userId, itemId])
  @@map("user_items")
}

// ======================
// МАФИЯ
// ======================

model StarOrder {
  id                       String   @id @default(cuid())
  userId                   String
  payload                  String   @unique
  productType              String
  gems                     Int      @default(0)
  stars                    Int
  status                   String   @default("PENDING")
  telegramPaymentChargeId  String?  @unique
  createdAt                DateTime @default(now())
  paidAt                   DateTime?
  user                     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@map("star_orders")
}

enum MafiaRoomStatus {
  WAITING     // ожидание игроков
  STARTING    // раздача ролей
  NIGHT       // ночная фаза
  DAY         // дневная фаза + обсуждение
  VOTING      // голосование
  FINISHED    // игра окончена
}

enum MafiaRole {
  CIVILIAN    // мирный житель
  MAFIA       // мафия
  DON         // дон мафии
  DOCTOR      // доктор
  SHERIFF     // шериф
  MANIAC      // маньяк
  COURTESAN   // красотка / путана
}

enum MafiaPhase {
  NIGHT_MAFIA
  NIGHT_DOCTOR
  NIGHT_SHERIFF
  NIGHT_MANIAC
  NIGHT_COURTESAN
  DAY_DISCUSSION
  DAY_VOTING
  DAY_LAST_WORDS
}

model MafiaRoom {
  id            String          @id @default(cuid())
  code          String          @unique  // короткий код комнаты (6 символов)
  name          String?
  hostId        String          // userId хоста
  status        MafiaRoomStatus @default(WAITING)
  maxPlayers    Int             @default(10)
  minPlayers    Int             @default(4)
  isPrivate     Boolean         @default(false)
  passwordHash  String?
  inviteOnly    Boolean         @default(false)
  
  // Настройки ролей
  rolesConfig   Json            // { civilian: 4, mafia: 2, doctor: 1, ... }
  
  // Текущая фаза
  currentPhase  MafiaPhase?
  dayNumber     Int             @default(0)
  phaseEndsAt   DateTime?
  
  // Результаты
  winner        String?         // "civilians" | "mafia" | "maniac"
  
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  startedAt     DateTime?
  finishedAt    DateTime?

  players       MafiaPlayer[]
  actions       MafiaAction[]
  votes         MafiaVote[]
  chatMessages  RoomMessage[]
  reactions     RoomReaction[]

  @@index([status])
  @@index([code])
  @@map("mafia_rooms")
}

model MafiaPlayer {
  id          String    @id @default(cuid())
  roomId      String
  userId      String
  role        MafiaRole?
  isAlive     Boolean   @default(true)
  isHost      Boolean   @default(false)
  seatNumber  Int?
  
  // Ночные действия текущего круга
  nightTarget String?   // id цели
  
  joinedAt    DateTime  @default(now())

  room MafiaRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User      @relation(fields: [userId], references: [id])

  @@unique([roomId, userId])
  @@index([roomId])
  @@map("mafia_players")
}

model MafiaAction {
  id        String   @id @default(cuid())
  roomId    String
  actorId   String   // MafiaPlayer.id
  targetId  String?  // MafiaPlayer.id
  action    String   // "kill" | "heal" | "check" | "seduce" | "maniac_kill"
  dayNumber Int
  phase     MafiaPhase
  createdAt DateTime @default(now())

  room MafiaRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([roomId, dayNumber])
  @@map("mafia_actions")
}

model MafiaVote {
  id        String   @id @default(cuid())
  roomId    String
  voterId   String   // MafiaPlayer.id
  targetId  String?  // MafiaPlayer.id (null = пропуск)
  dayNumber Int
  createdAt DateTime @default(now())

  room MafiaRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@unique([roomId, voterId, dayNumber])
  @@map("mafia_votes")
}


// ======================
// ПРОГРЕСС, НАГРАДЫ И ИСТОРИЯ
// ======================

model DailyReward {
  id        String   @id @default(cuid())
  userId    String
  dateKey   String
  coins     Int
  xp        Int
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dateKey])
  @@index([userId, createdAt])
  @@map("daily_rewards")
}

model Achievement {
  id          String   @id
  title       String
  description String
  icon        String   @default("💠")
  xpReward    Int      @default(0)
  coinsReward Int      @default(0)
  users       UserAchievement[]

  @@map("achievements")
}

model UserAchievement {
  id            String   @id @default(cuid())
  userId        String
  achievementId String
  unlockedAt    DateTime @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
  @@index([userId])
  @@map("user_achievements")
}

model MatchHistory {
  id           String   @id @default(cuid())
  userId       String
  gameId       String
  roomId       String?
  result       String
  winner       String?
  summary      String?
  playersCount Int      @default(0)
  xpEarned     Int      @default(0)
  coinsEarned  Int      @default(0)
  playedAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, playedAt])
  @@index([gameId, playedAt])
  @@map("match_history")
}


// ======================
// GAMEHUB SOCIAL + SETTINGS
// ======================

model UserSettings {
  id             String   @id @default(cuid())
  userId         String   @unique
  displayName    String?
  avatarUrl      String?
  theme          String   @default("dark")
  soundEnabled   Boolean  @default(true)
  notifications  Boolean  @default(true)
  language       String   @default("ru")
  accentColor    String   @default("ruby")
  compactMode    Boolean  @default(false)
  animations     Boolean  @default(true)
  backgroundStyle String  @default("aurora")
  profileFrame   String?
  nicknameColor String?
  profileBadge  String?
  profileBackground String?
  avatarAnimation String?
  profileEffect String?
  profileTitle String?
  profileBio String?
  profileShowcase String[] @default([])
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@map("user_settings")
}

model RoomMessage {
  id        String   @id @default(cuid())
  roomId    String
  userId    String
  content   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  room      MafiaRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  @@index([roomId, createdAt])
  @@map("room_messages")
}

model RoomReaction {
  id        String   @id @default(cuid())
  roomId    String
  userId    String
  emoji     String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  room      MafiaRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  @@index([roomId, createdAt])
  @@map("room_reactions")
}

model PlayerReport {
  id          String   @id @default(cuid())
  authorId    String
  targetId    String
  roomId      String?
  reason      String
  details     String?
  status      String   @default("OPEN")
  createdAt   DateTime @default(now())
  author      User     @relation("ReportAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  target      User     @relation("ReportTarget", fields: [targetId], references: [id], onDelete: Cascade)
  @@index([status, createdAt])
  @@map("player_reports")
}

model Season {
  id        String   @id @default(cuid())
  name      String
  startsAt  DateTime
  endsAt    DateTime
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now())
  rewards   SeasonReward[]
  battlePassClaims BattlePassClaim[]
  battlePassUnlocks BattlePassUnlock[]
  @@map("seasons")
}


model AdminStaff {
  id          String   @id @default(cuid())
  userId      String   @unique
  role        String
  permissions Json     @default("[]")
  appointedBy BigInt
  appointedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([role])
  @@map("admin_staff")
}

model AdminActionLog {
  id               String   @id @default(cuid())
  actorTelegramId  BigInt
  targetUserId     String?
  action           String
  reason           String?
  metadata         Json?
  createdAt        DateTime @default(now())

  @@index([actorTelegramId, createdAt])
  @@index([targetUserId, createdAt])
  @@map("admin_action_logs")
}

model XpTransaction {
  id              String   @id @default(cuid())
  userId          String
  amount          Int
  balanceAfter    Int
  source          String
  reason          String
  actorTelegramId BigInt?
  createdAt       DateTime @default(now())
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("xp_transactions")
}


model NftGift {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String
  rarity      String
  imageUrl    String
  supply      Int?
  issued      Int      @default(0)
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  orders      NftOrder[]
  owners      UserNft[]
  @@index([rarity, sortOrder])
  @@map("nft_gifts")
}

model NftOrder {
  id          String   @id @default(cuid())
  userId      String
  giftId      String
  status      String   @default("PENDING")
  buyerNote   String?
  adminNote   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  gift        NftGift  @relation(fields: [giftId], references: [id])
  ownership   UserNft?
  @@index([status, createdAt])
  @@index([userId, createdAt])
  @@map("nft_orders")
}

model UserNft {
  id           String   @id @default(cuid())
  userId       String
  giftId       String
  orderId      String   @unique
  serialNumber Int      @default(1)
  acquiredAt   DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  gift         NftGift  @relation(fields: [giftId], references: [id])
  order        NftOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  @@index([userId, acquiredAt])
  @@map("user_nfts")
}

model DirectMessage {
  id          String   @id @default(cuid())
  senderId    String
  recipientId String
  content     String
  createdAt   DateTime @default(now())
  readAt      DateTime?
  sender      User     @relation("DirectMessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipient   User     @relation("DirectMessageRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  reports     MessageReport[]
  @@index([senderId, recipientId, createdAt])
  @@index([recipientId, senderId, createdAt])
  @@map("direct_messages")
}

model UserBlock {
  id        String   @id @default(cuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())
  blocker   User     @relation("BlockOwner", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User     @relation("BlockTarget", fields: [blockedId], references: [id], onDelete: Cascade)
  @@unique([blockerId, blockedId])
  @@index([blockedId])
  @@map("user_blocks")
}

model MessageReport {
  id         String   @id @default(cuid())
  reporterId String
  messageId  String
  reason     String
  status     String   @default("OPEN")
  createdAt  DateTime @default(now())
  reporter   User          @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  message    DirectMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  @@unique([reporterId, messageId])
  @@index([status, createdAt])
  @@map("message_reports")
}


// ======================
// GROUP CHAT GAMES
// ======================

model GroupGameRoom {
  id        String   @id @default(cuid())
  chatId    BigInt
  messageId Int?
  hostId    BigInt
  gameId    String
  status    String   @default("WAITING")
  players   Json     @default("[]")
  state     Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([chatId, status])
  @@index([status, createdAt])
  @@map("group_game_rooms")
}


// ======================
// GAMEHUB 2.0: COMMUNITY, QUESTS AND SEASON REWARDS
// ======================

model Friendship {
  id          String   @id @default(cuid())
  requesterId String
  addresseeId String
  status      String   @default("PENDING")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  requester   User     @relation("FriendshipRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee   User     @relation("FriendshipAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)

  @@unique([requesterId, addresseeId])
  @@index([addresseeId, status, createdAt])
  @@index([requesterId, status, createdAt])
  @@map("friendships")
}

model PlayerChallenge {
  id          String   @id @default(cuid())
  challengerId String
  challengedId String
  gameId      String   @default("mafia")
  status      String   @default("PENDING")
  createdAt   DateTime @default(now())
  challenger  User     @relation("ChallengeSender", fields: [challengerId], references: [id], onDelete: Cascade)
  challenged  User     @relation("ChallengeRecipient", fields: [challengedId], references: [id], onDelete: Cascade)

  @@index([challengedId, status, createdAt])
  @@index([challengerId, status, createdAt])
  @@map("player_challenges")
}

model Clan {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  tag         String   @unique @default("CLAN")
  description String?
  avatarUrl   String?
  bannerUrl   String?
  emblem      String?  @default("🛡️")
  ownerId     String
  isPublic    Boolean  @default(true)
  announcement String?
  level       Int      @default(1)
  xp          Int      @default(0)
  inviteCode  String?  @unique
  tagColor    String   @default("#a78bfa")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  owner       User     @relation("ClanOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members     ClanMember[]
  applications ClanApplication[]
  actionLogs ClanActionLog[]
  trophies ClanTrophy[]

  @@index([name])
  @@map("clans")
}

model ClanMember {
  id       String   @id @default(cuid())
  clanId   String
  userId   String
  role     String   @default("MEMBER")
  joinedAt DateTime @default(now())
  clan     Clan     @relation(fields: [clanId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([clanId, userId])
  @@index([userId, joinedAt])
  @@map("clan_members")
}

model AppNotification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  title     String
  body      String?
  href      String?
  readAt    DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@map("app_notifications")
}

model QuestClaim {
  id          String   @id @default(cuid())
  userId      String
  questCode   String
  dateKey     String
  rewardXp    Int
  rewardCoins Int
  claimedAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dateKey, questCode])
  @@index([userId, claimedAt])
  @@map("quest_claims")
}

model SeasonReward {
  id          String   @id @default(cuid())
  seasonId    String
  userId      String
  place       Int
  rewardXp    Int
  rewardCoins Int
  awardedAt   DateTime @default(now())
  season      Season   @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([seasonId, userId])
  @@unique([seasonId, place])
  @@map("season_rewards")
}


model BattlePassClaim {
  id        String   @id @default(cuid())
  seasonId  String
  userId    String
  tier      Int
  track     String
  rewardKey String
  claimedAt DateTime @default(now())
  season    Season   @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([seasonId, userId, tier, track])
  @@index([userId, claimedAt])
  @@map("battle_pass_claims")
}

model BattlePassUnlock {
  id        String   @id @default(cuid())
  seasonId  String
  userId    String
  priceGems Int      @default(400)
  unlockedAt DateTime @default(now())
  season    Season   @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([seasonId, userId])
  @@map("battle_pass_unlocks")
}


// ======================
// BUNKER GAME
// ======================
model BunkerRoom {
  id          String   @id @default(cuid())
  code        String   @unique
  hostId      String
  status      String   @default("WAITING")
  round       Int      @default(0)
  maxPlayers  Int      @default(12)
  eliminated  String[] @default([])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  players     BunkerPlayer[]
  @@index([status, createdAt])
  @@map("bunker_rooms")
}

model BunkerPlayer {
  id          String   @id @default(cuid())
  roomId      String
  userId      String
  isHost      Boolean  @default(false)
  character   Json?
  voteTarget  String?
  joinedAt    DateTime @default(now())
  room        BunkerRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user        User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([roomId, userId])
  @@index([roomId])
  @@map("bunker_players")
}


model ClanApplication {
  id        String   @id @default(cuid())
  clanId    String
  userId    String
  status    String   @default("PENDING")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  clan      Clan @relation(fields: [clanId], references: [id], onDelete: Cascade)
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([clanId, userId])
  @@index([clanId, status, createdAt])
  @@map("clan_applications")
}

model ClanActionLog {
  id        String   @id @default(cuid())
  clanId    String
  actorId   String
  action    String
  details   String?
  createdAt DateTime @default(now())
  clan      Clan @relation(fields: [clanId], references: [id], onDelete: Cascade)
  @@index([clanId, createdAt])
  @@map("clan_action_logs")
}

model ClanTrophy {
  id          String   @id @default(cuid())
  clanId      String
  title       String
  description String?
  icon        String   @default("🏆")
  awardedAt   DateTime @default(now())
  clan        Clan @relation(fields: [clanId], references: [id], onDelete: Cascade)
  @@index([clanId, awardedAt])
  @@map("clan_trophies")
}
